# Required: a long, private random string used to sign login sessions
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Required: the ONLY credentials that can open the /admin dashboard
ADMIN_EMAIL="your-admin-email@example.com"
ADMIN_PASSWORD="replace-with-a-strong-private-admin-password"

# Optional. This demo build currently stores temporary sandbox data in Vercel runtime storage.
# It resets when a serverless instance is replaced. Add PostgreSQL later for persistent data.
# DATABASE_URL="postgresql://..."

# Optional: add only if you later implement Vercel Blob profile-picture uploads.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
NEXT_PUBLIC_APP_NAME="Global Trust Bank Demo"
